{
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!node_modules",
      "!!native/uninstaller/.build",
      "!!native/lifecycle-lock/build",
      "!!out",
      "!!playwright-report",
      "!!test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
