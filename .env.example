CONVO_CADDY_HOST=127.0.0.1
CONVO_CADDY_PORT=4317
# Developer reasoning stays disabled unless this local Hermes bearer token is set.
# CONVO_CADDY_HERMES_API_KEY=replace-with-your-hermes-api-key
# CONVO_CADDY_HERMES_URL=http://127.0.0.1:8642
# CONVO_CADDY_HERMES_MODEL=interview-assistant
# CONVO_CADDY_HERMES_TIMEOUT_MS=30000
# CONVO_CADDY_HERMES_MAX_INPUT_BYTES=60000

# Developer live capture is disabled unless this complete set is supplied.
# CONVO_CADDY_RECALL_API_KEY=replace-with-the-us-west-2-api-key
# CONVO_CADDY_RECALL_VERIFICATION_SECRET=whsec_replace-with-workspace-secret
# CONVO_CADDY_RECALL_WEBHOOK_URL=https://interviews.example.ngrok-free.dev/api/capture/recall/webhook
# CONVO_CADDY_RECALL_WEBHOOK_PORT=4318
# CONVO_CADDY_RECALL_TIMEOUT_MS=30000
