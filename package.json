{
  "name": "convo-caddy",
  "productName": "Convo Caddy",
  "version": "0.1.0",
  "description": "An unsupported source alpha for a live interview companion on macOS.",
  "author": "Frameyard",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.mjs",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "dev:desktop": "pnpm build && electron dist/desktop/main.mjs",
    "fixture:recall": "tsx scripts/recall-fixture-listener.ts",
    "fixture:recall:redact": "tsx scripts/recall-fixture-redactor.ts",
    "audit:electron": "vitest run tests/desktop tests/server/local-api-security.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:client": "vite build",
    "build:desktop": "tsx scripts/build-desktop.ts",
    "build:maintenance-lock": "tsx scripts/build-maintenance-lock.ts",
    "build:uninstaller": "tsx scripts/build-uninstaller.ts",
    "build:icon": "tsx scripts/build-app-icon.ts",
    "build": "pnpm build:client && pnpm build:desktop",
    "build:mac": "pnpm build && pnpm build:icon && pnpm build:uninstaller",
    "prepare:package:mac": "tsx scripts/prepare-macos-packaging.ts",
    "stage:package:mac": "tsx scripts/clean-package-stage.ts && pnpm --filter convo-caddy deploy --prod dist/package-runtime && tsx scripts/stage-production-dependencies.ts",
    "package:mac": "pnpm prepare:package:mac && pnpm build:mac && pnpm stage:package:mac && electron-forge package --platform=darwin",
    "make:mac": "pnpm prepare:package:mac && pnpm build:mac && pnpm stage:package:mac && electron-forge make --platform=darwin",
    "make:mac:release": "pnpm prepare:package:mac && pnpm build:mac && tsx scripts/notarize-release-uninstaller.ts && pnpm stage:package:mac && electron-forge make --platform=darwin",
    "verify:package:mac": "tsx scripts/verify-package-mac.ts",
    "verify:install-uninstall:mac": "tsx scripts/verify-install-uninstall-mac.ts",
    "verify:public-tree": "tsx scripts/verify-public-tree.ts",
    "prepare:release:mac": "bash scripts/prepare-release-mac.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm verify:public-tree"
  },
  "dependencies": {
    "@ngrok/ngrok": "1.7.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "4.3.0",
    "@electron/fuses": "2.1.3",
    "@electron/node-gyp": "10.2.0-electron.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "electron": "44.0.0",
    "esbuild": "0.28.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
